{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/retraction.schema.json",
  "title": "Retraction",
  "description": "One line of retractions.jsonl, written only by `meta claim retract`: an append-only tombstone. The claim stays in its shard; merge, graph, findings, G2 and report skip it (D-087). schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "reason",
    "at"
  ]
}
