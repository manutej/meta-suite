{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/judgment.schema.json",
  "title": "Judgment",
  "description": "J1 judgment record. Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "task": {
      "enum": [
        "judge",
        "answer"
      ]
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "producer_model": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": [
        "string",
        "number",
        "boolean",
        "object",
        "array"
      ]
    },
    "blind": {
      "type": "boolean"
    },
    "same_model": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "task",
    "prompt_hash",
    "model",
    "temperature",
    "producer_model",
    "output",
    "blind"
  ]
}
