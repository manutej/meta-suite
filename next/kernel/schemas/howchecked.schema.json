{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/howchecked.schema.json",
  "title": "HowChecked",
  "description": "how_checked.json, written only by `meta report` from recorded gate results and the run's files. The page's \"how this was checked\" is rendered from it (D-087). schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "fast",
        "deep_narrow",
        "deep_broad"
      ]
    },
    "kernel": {
      "enum": [
        "present",
        "absent"
      ]
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "min_independent": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "type": "integer",
          "minimum": 0
        },
        "independent_sources": {
          "type": "integer",
          "minimum": 0
        },
        "regions_planned": {
          "type": "integer",
          "minimum": 0
        },
        "regions_gathered": {
          "type": "integer",
          "minimum": 0
        },
        "regions_not_gathered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claims_by_region": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "single_source": {
          "type": "integer",
          "minimum": 0
        },
        "contested_findings": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "shared_entities": {
          "type": "integer",
          "minimum": 0
        },
        "regions_combined": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unit_conversions": {
          "type": "integer",
          "minimum": 0
        },
        "dated_claims": {
          "type": "integer",
          "minimum": 0
        },
        "retracted_claims": {
          "type": "integer",
          "minimum": 0
        },
        "deviations": {
          "type": "integer",
          "minimum": 0
        },
        "deviations_by_stage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "claims",
        "sources",
        "independent_sources",
        "regions_planned",
        "regions_gathered",
        "regions_not_gathered",
        "claims_by_region",
        "findings",
        "verified",
        "single_source",
        "contested_findings",
        "conflicts",
        "shared_entities",
        "regions_combined",
        "unit_conversions",
        "dated_claims",
        "retracted_claims",
        "deviations",
        "deviations_by_stage"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unchecked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "gate",
          "name",
          "status"
        ]
      }
    },
    "gates_passed": {
      "type": "integer",
      "minimum": 0
    },
    "gates_failed": {
      "type": "integer",
      "minimum": 0
    },
    "gates_unchecked": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "seq",
          "at",
          "stage",
          "note"
        ]
      }
    },
    "retractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "stage": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason",
          "at"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            }
          }
        },
        "required": [
          "locator",
          "publisher",
          "retrieved_at",
          "claim_ids"
        ]
      }
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "mode",
    "kernel",
    "config_hash",
    "schema_version",
    "rule",
    "min_independent",
    "counts",
    "gates",
    "gates_passed",
    "gates_failed",
    "gates_unchecked",
    "summary",
    "limits",
    "deviations",
    "retractions",
    "sources"
  ]
}
