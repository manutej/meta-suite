{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/editscript.schema.json",
  "title": "EditScript",
  "description": "R1 output: edits only. Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_stage": {
            "enum": [
              "I1",
              "I2",
              "I3",
              "D1",
              "D2",
              "D3",
              "L1",
              "L2",
              "L3",
              "L4",
              "G3",
              "G4",
              "A1",
              "A2",
              "R1",
              "R2",
              "S1",
              "S2"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "enum": [
              "add",
              "remove",
              "rewrite",
              "regather",
              "relabel"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "required": [
          "target_stage",
          "target_id",
          "op",
          "rationale",
          "priority"
        ]
      }
    },
    "reviewer_model": {
      "type": "string",
      "minLength": 1
    },
    "blind": {
      "type": "boolean"
    },
    "pass": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "edits",
    "reviewer_model",
    "blind"
  ]
}
