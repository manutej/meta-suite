{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/runrecord.schema.json",
  "title": "RunRecord",
  "description": "run.json: the run's record (S1). Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "brief_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "fast",
        "deep_narrow",
        "deep_broad"
      ]
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "kernel": {
      "enum": [
        "present",
        "absent"
      ]
    },
    "kernel_version": {
      "type": "string",
      "minLength": 1
    },
    "model_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "prompt_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config_source": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "playbook_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "enum": [
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unchecked"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          },
          "inputs_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "gate",
          "verdict",
          "at"
        ]
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "api",
            "harness",
            "estimated"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "calls"
      ]
    },
    "wall_ms": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "internal_view": {
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "brief_hash",
    "mode",
    "surface",
    "kernel",
    "model_map",
    "prompt_hashes",
    "config_hash",
    "schema_version",
    "playbook_hash",
    "gate_results",
    "usage",
    "wall_ms",
    "seed"
  ]
}
