{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/spec.schema.json",
  "title": "Spec",
  "description": "Expanded, faithful spec produced by I2. hash is optional on input; the kernel computes it. Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "origin": {
            "enum": [
              "stated",
              "inferred",
              "default"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "type",
          "required",
          "origin"
        ]
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "stated",
              "inferred",
              "default"
            ]
          }
        },
        "required": [
          "text",
          "origin"
        ]
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "satisfied_by": {
            "enum": [
              "verified",
              "single_source",
              "exception",
              "tension",
              "obstruction",
              "profile_trait",
              "coarse_model",
              "uncertain",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          }
        },
        "required": [
          "criterion",
          "satisfied_by"
        ]
      },
      "minItems": 1
    },
    "scope": {
      "enum": [
        "narrow",
        "broad"
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "objective",
    "slots",
    "constraints",
    "success_criteria"
  ]
}
