{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/artifactplan.schema.json",
  "title": "ArtifactPlan",
  "description": "A1 plan: form, layout, host type, rule id and rationale. Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "form": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "host_type": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+$"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "form",
    "layout",
    "rule_id",
    "rationale"
  ]
}
