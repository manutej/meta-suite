{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/meta-suite/next/kernel/schemas/regiongraph.schema.json",
  "title": "RegionGraph",
  "description": "Per-region typed graph built by `meta graph build`. Spec: spec/v2/03-architecture.md, Core types. schema_version 2.0.0-alpha.1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "region": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "entity"
            ]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "labels"
        ]
      }
    },
    "morphisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "dst": {
            "type": "string",
            "minLength": 1
          },
          "relation_type": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "src",
          "dst",
          "relation_type",
          "claim_ids"
        ]
      }
    },
    "shape_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub_concentration": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "longest_chain": {
          "type": "integer",
          "minimum": 0
        },
        "two_sidedness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporal_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "hub_concentration",
        "longest_chain",
        "two_sidedness",
        "temporal_density"
      ]
    }
  },
  "required": [
    "region",
    "objects",
    "morphisms",
    "shape_metrics"
  ]
}
